clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard
clipboard-paste-protection = false
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+i=text:\x01y
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+down=goto_split:bottom
keybind = cmd+opt+up=goto_split:top
keybind = cmd+opt+right=goto_split:right
scrollback-limit = 2147483648
auto-update-channel = tip

shell-integration = zsh
shell-integration-features = ssh-env,ssh-terminfo,sudo

keybind = global:opt+backquote=toggle_quick_terminal

bell-features = no-audio, no-system
