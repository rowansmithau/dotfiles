[user]
	name = Rowan Smith
	email = rowan@coder.com
[gpg]
	format = ssh
[gpg "ssh"]
	defaultKeyCommand = ssh-add -L
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[core]
	pager = cat
[init]
	defaultBranch = main

# commit signing via ssh uses remote signing from bitwarden. 
# requires `export SSH_AUTH_SOCK=~/.bitwarden-ssh-agent.sock` in shell and
# `Host *.IdentityAgent ~/.bitwarden-ssh-agent.sock` in ssh/config
